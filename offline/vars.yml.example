# Site-specific values for manifest.yml. Copy this file to vars.yml and edit it for your foundation.
# No credentials live here - the apps read Postgres and their model endpoints from their service
# bindings - so vars.yml is safe to keep alongside the jars. ./preflight.sh checks it all before you
# push: every variable the manifest uses has a value, the files exist, the buildpacks and services
# exist on the foundation you are targeting, and the routes sit on a domain it actually has.

# --- Routes (fully-qualified hostnames, no scheme). The frontend is built to call the backend at
# --- https://<backend-route>, and the backend's CORS origin is https://<frontend-route>; both come
# --- from these two values, so they cannot disagree. `cf domains` lists the domains you can use.
backend-route: client-rag-demo-backend.apps.example.com
frontend-route: client-rag-demo-frontend.apps.example.com

# --- Files, relative to this folder. GitHub Packages names SNAPSHOT jars with a timestamp
# --- (e.g. client-rag-demo-backend-0.0.1-20261015.171059-2.jar) - use the name you downloaded.
backend-jar: ./client-rag-demo-backend-0.0.1-SNAPSHOT.jar
batch-jar: ./client-rag-demo-sharepoint-batch-0.0.1-SNAPSHOT.jar
frontend-dir: ./frontend-dist

# --- Buildpacks (`cf buildpacks`). The Java one must bundle a Java 25 JRE.
java-buildpack: java_buildpack_offline
staticfile-buildpack: staticfile_buildpack

# --- Service instances (`cf services`). Create the two GenAI ones first, each on a single-model
# --- plan so which model is used is explicit (`cf marketplace -e ai-models` lists the plans):
# ---   cf create-service ai-models <chat-model-plan>      <chat-service>    (a CHAT model)
# ---   cf create-service ai-models <embedding-model-plan> <embed-service>   (a 768-dimension EMBEDDING model)
# --- The same names drive both the app's binding and the app's lookup of it.
db-service: client-rag-demo-db
chat-service: client-rag-demo-chat
embed-service: client-rag-demo-embed
# Only used when ingestion-source is filesystem (a block-storage / NFS-style volume).
volume-service: rag-docs-volume

# --- sharepoint-batch input: filesystem (a mounted directory) or graph (Microsoft Graph).
# --- graph needs tenant/site/drive settings this template does not cover - see README.md.
ingestion-source: filesystem

# --- Tuning. chunk-size is shared by the backend and the batch app (they write into the same
# --- vector store). 128 suits an embedding model with a 512-token limit; lower it if documents
# --- fail to embed with a "too many tokens" error. Memory suits the JVM apps' document parsing.
chunk-size: "128"
backend-memory: 1500M
batch-memory: 1500M
startup-timeout: 180
